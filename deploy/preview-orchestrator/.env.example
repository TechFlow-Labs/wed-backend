# HTTP auth used by PR workflows (same value as PREVIEW_ORCHESTRATOR_TOKEN secret in GitHub)
PREVIEW_ORCHESTRATOR_TOKEN=replace-me

# Coolify API
COOLIFY_BASE_URL=https://coolify.yourdomain.com
COOLIFY_API_TOKEN=replace-me
COOLIFY_PROJECT_UUID=replace-me
COOLIFY_ENVIRONMENT_NAME=production
COOLIFY_DESTINATION_UUID=replace-me

# Wildcard preview domain base
PREVIEW_BASE_DOMAIN=preview.techflowlabs.gr

# Repo sources
BACKEND_REPO_URL=https://github.com/TechFlow-Labs/wed-backend.git
MAIN_REPO_URL=https://github.com/TechFlow-Labs/wed-main-mvp.git
SSR_REPO_URL=https://github.com/TechFlow-Labs/wed-ssr-mvp.git

# Branch fallback (used if feature branch does not exist in that repo)
BACKEND_FALLBACK_BRANCH=main
MAIN_FALLBACK_BRANCH=main
SSR_FALLBACK_BRANCH=main

# Optional GitHub token for branch existence checks
GITHUB_TOKEN=

# API timeout
REQUEST_TIMEOUT_SECONDS=25

# Backend env injection for preview API apps (required)
ORCH_BACKEND_DB_USER=postgres
ORCH_BACKEND_DB_PASSWORD=replace-me
ORCH_BACKEND_DB_HOST=postgres
ORCH_BACKEND_DB_PORT=5432
ORCH_BACKEND_DB_DATABASE=postgres
ORCH_BACKEND_JWT_SECRET_KEY=replace-me
ORCH_BACKEND_JWT_REFRESH_SECRET_KEY=replace-me

# Backend env injection (optional)
ORCH_BACKEND_APP_MODULE=app:app
ORCH_BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=5000
ORCH_BACKEND_REFRESH_TOKEN_EXPIRE_MINUTES=10080
ORCH_BACKEND_ALGORITHM=HS256
ORCH_BACKEND_MAIL_USERNAME=
ORCH_BACKEND_MAIL_PASSWORD=
ORCH_BACKEND_MAIL_FROM=
ORCH_BACKEND_MAIL_PORT=
ORCH_BACKEND_MAIL_SERVER=
