# Public domain routed by Coolify/Traefik
APP_DOMAIN=api.example.com

# Uvicorn runtime
API_HOST=0.0.0.0
API_PORT=8000
APP_MODULE=app.main:app

# JWT / Auth
ACCESS_TOKEN_EXPIRE_MINUTES=5000
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256
JWT_SECRET_KEY=replace-with-secure-secret
JWT_REFRESH_SECRET_KEY=replace-with-secure-refresh-secret

# Database connection for the API container
DB_USER=postgres
DB_PASSWORD=replace-with-secure-db-password
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=postgres

# Mail settings
MAIL_USERNAME=info@example.com
MAIL_PASSWORD=replace-with-mail-password
MAIL_FROM=info@example.com
MAIL_PORT=465
MAIL_SERVER=smtp.example.com
